ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# Paper-trade gate defaults
PAPER_MIN_TRADES=30
PAPER_MIN_PROFIT_FACTOR=1.1
PAPER_MAX_DRAWDOWN_PCT=12
PAPER_MIN_EXPECTANCY=0.01

# Notification placeholders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_BASE_URL=
WHATSAPP_API_KEY=
